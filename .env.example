# Copia este archivo a ".env" (sin .example) y pega tu API Key real ahí.
# El archivo .env NO se sube a Git (está en .gitignore).

# Ambiente: "test" para apiimpulsa.azurewebsites.net, "prod" para producción.
IMPULSA_ENV=test

# La API Key que te da SPI/Impulsa. Cuando rote, actualizar acá.
IMPULSA_API_KEY=pega-aqui-tu-api-key

# Código SAP del establecimiento Serviautec (confirmado del panel Impulsa).
IMPULSA_ESTABLECIMIENTO=550026948

# Usuario que figura como creador de la oportunidad en Impulsa.
IMPULSA_USUARIO=yeimi

# Código DANE del municipio donde se cierra la venta. 05001 = Medellín.
IMPULSA_CODIGO_DANE=05001

# Origen de la oportunidad (texto libre, Impulsa lo autocrea si no existe).
IMPULSA_ORIGEN=Venta Yeimy

# Campaña de la oportunidad (texto libre, Impulsa la autocrea si no existe).
IMPULSA_CAMPANNA=Venta directa redes Yeimy

# API key de Anthropic (Claude) para OCR de facturas Auteco.
# Generar en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Siigo API (lectura de inventario contable) ---
# Generar en Siigo Nube → ⚙️ → Más configuraciones → API/Integraciones
# Credenciales de Serviautec Concesionario SAS (plan Emprendedor)
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
# Identificador de la integración (texto libre, va en header Partner-Id)
SIIGO_PARTNER_ID=ServiautecConcesionario

# Puerto local del servidor (cambia solo si 3000 está ocupado).
PORT=3000
